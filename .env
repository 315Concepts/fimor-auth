# Use to control environment variables for docker compose at runtime (interpolation)
# SOME_ENV_VAR=${SOME_ENV_VAR:-true}

###############
### REQUIRED VARIABLES
# Root domain to hang the project off of
SERVICE_DOMAIN=${SERVICE_DOMAIN:1}
# Contact email for Traefik certificate resolver
ACME_CERTIFICATE_EMAIL=${ACME_CERTIFICATE_EMAIL:1}

###############
### STACK VERSIONS
# POSTGRES
POSTGRES_VERSION=${POSTGRES_VERSION:-18.3}
# ORY
ORY_VERSION=${ORY_VERSION:-26.2.0}
# TRAEFIK
TRAEFIK_VERSION=${TRAEFIK_VERSION:-3.6}

###############
### POSTGRES
# Cluster defaults
POSTGRES_USER=${POSTGRES_USER:-orydbuser}
POSTGRES_PASSWORD=${POSTGRES_PASSWORD:-orydbpass}
POSTGRES_DB=${POSTGRES_DB:-postgres}
# Service databases
POSTGRES_KRATOS_DB=${POSTGRES_KRATOS_DB:-kratos}
POSTGRES_HYDRA_DB=${POSTGRES_HYDRA_DB:-hydra}

###############
### DEBUG
## CONSENT UI
CONSENT_SUBDOMAIN=${CONSENT_SUBDOMAIN:-consent}
## CONSENT CLIENT
# CONSENT_CLIENT_ID=${CONSENT_CLIENT_ID:?Must be set for consent debug}
# CONSENT_CLIENT_SECRET=${CONSENT_CLIENT_SECRET:?Must be set for consent debug}
## CREDENTIAL CLIENT
# CREDENTIAL_CLIENT_ID=${CREDENTIAL_CLIENT_ID:?Must be set for credential debug}
# CREDENTIAL_CLIENT_SECRET=${CREDENTIAL_CLIENT_SECRET:?Must be set for credential debug}
## MAILSLURP
MAIL_SUBDOMAIN=${MAIL_SUBDOMAIN:-webmail}
SLURP_SUBDOMAIN=${SLURP_SUBDOMAIN:-slurp}
SMTP_SUBDOMAIN=${SMTP_SUBDOMAIN:-smtp}
## WHOAMI
WHOAMI_PUBLIC_PATH=${WHOAMI_PUBLIC_PATH:-/whoami}

###############
### ORY
## KRATOS
KRATOS_COOKIE_SECRET=${KRATOS_COOKIE_SECRET:1}
KRATOS_CIPHER_SECRET=${KRATOS_CIPHER_SECRET:1}
## HYDRA
HYDRA_SYSTEM_SECRET=${HYDRA_SYSTEM_SECRET:1}
## SELF SERVICE
SELFSERVE_COOKIE_SECRET=${SELFSERVE_COOKIE_SECRET:1}
SELFSERVE_CSRF_COOKIE_SECRET=${SELFSERVE_CSRF_COOKIE_SECRET:1}
SELFSERVE_CSRF_COOKIE_NAME=${SELFSERVE_CSRF_COOKIE_NAME:-ory_csrf_ui}
## SMTP SERVICE
ORY_SMTP_AUTH=${ORY_SMTP_AUTH:-test:test} # Debug by default
ORY_SMTP_CONNECTION_URI=${ORY_SMTP_CONNECTION_URI:-smtps://${ORY_SMTP_AUTH}@${SMTP_SUBDOMAIN}.${SERVICE_DOMAIN}:1025/?skip_ssl_verify=true} # Debug by default

###############
### TRAEFIK
# ADMIN ENTRYPOINT
PRIVATE_HTTPS_PORT=${PRIVATE_HTTPS_PORT:-8443}
# Default ACME resolver for Traefik (stg/prd)
ACME_DEFAULT_RESOLVER=${ACME_DEFAULT_RESOLVER:-stg} # STG by default
# Routing identifiers
## TRAEFIK
TRAEFIK_SUBDOMAIN=${TRAEFIK_SUBDOMAIN:-traefik}
## KRATOS
KRATOS_PUBLIC_PATH=${KRATOS_PUBLIC_PATH:-/session}
KRATOS_ADMIN_PATH=${KRATOS_ADMIN_PATH:-/kratos}
## HYDRA
HYDRA_PUBLIC_PATH=${HYDRA_PUBLIC_PATH:-/oauth}
HYDRA_ADMIN_PATH=${HYDRA_ADMIN_PATH:-/hydra}
## ORY ADMIN UI
ADMIN_SUBDOMAIN=${ADMIN_SUBDOMAIN:-admin}
